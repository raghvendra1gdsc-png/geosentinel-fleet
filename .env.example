# GeoSentinel Fleet Backend Environment Variables

# 1. Google Gemini API Key (Required for live multi-turn LLM reasoning)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Model Identifier (Defaults to gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# 3. CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
# Local: http://localhost:5173
# Production: https://geosentinel-fleet.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173,https://geosentinel-fleet.vercel.app

# 4. Emergency Engineering Thresholds
SAFETY_FACTOR_THRESHOLD=1.5
SANDBOX_TIMEOUT_SECONDS=15

# 5. Network Binding (Automatically provided by Render/Cloud platforms as $PORT)
HOST=0.0.0.0
PORT=8000
